<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Version>1.0.5</Version>
    <!-- Explorer / taskbar icon of the .exe on Windows -->
    <ApplicationIcon>Icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.4.1" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Physics.fs" />
    <Compile Include="Terrain.fs" />
    <Compile Include="Weapons.fs" />
    <Compile Include="Types.fs" />
    <Compile Include="Entities.fs" />
    <Compile Include="Game.fs" />
    <Compile Include="Renderer.fs" />
    <Compile Include="ShortcutKeys.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

  <!-- Window icon: MonoGame DesktopGL loads the embedded Icon.bmp -->
  <ItemGroup>
    <EmbeddedResource Include="Icon.bmp" LogicalName="Icon.bmp" />
  </ItemGroup>

  <!-- Copy all .LEV level files to the output directory -->
  <ItemGroup>
    <None Include="*.LEV" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
